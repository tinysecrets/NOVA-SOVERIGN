# NOVA — local-first configuration template. Copy to .env and replace placeholders.
# Keep .env private; never commit real credentials.
DB_NAME=nova_assistant
JWT_SECRET=replace-with-a-long-random-secret-before-starting
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-before-starting

# Local inference is the default. Start Ollama on the host and pull this model.
LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODELS=llama3.1:8b

# Explicit browser origins only; the Docker port is bound to loopback.
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Optional cloud mode. Leave blank unless intentionally opting into Emergent.
# To enable it explicitly, set LLM_BACKEND=emergent and add your own key.
EMERGENT_LLM_KEY=
